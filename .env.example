# ---------------------------------------------------------------------------
# Domiutra website: environment variables
# Copy to .env.local for local development. Every variable is optional:
# features that depend on an unset variable are hidden or report honestly
# that they're not configured. Never commit real values.
# ---------------------------------------------------------------------------

# Canonical site URL (no trailing slash). Used for canonical links, sitemap,
# Open Graph, and JSON-LD. On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used
# automatically if this is unset.
NEXT_PUBLIC_SITE_URL=

# --- Contact form (server-side) --------------------------------------------
# Both are required for the form to deliver messages. If either is missing,
# the form tells visitors their message was NOT sent (it never fakes success).
RESEND_API_KEY=
# Inbox(es) that receive inquiries. Comma-separate multiple addresses.
CONTACT_EMAIL=
# Verified sender in Resend, e.g. "Domiutra Website <website@yourdomain.com>".
# Defaults to Resend's onboarding sender, which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=

# --- Optional CRM forwarding ------------------------------------------------
# HubSpot private app token with crm.objects.contacts.write scope.
HUBSPOT_ACCESS_TOKEN=

# --- AI brief assistant (server-side) --------------------------------------
# Enables the Gemini-powered project brief assistant (homepage, /brief, contact
# page link). Get a key at https://aistudio.google.com. Never expose it publicly.
GEMINI_API_KEY=
# Optional model override (default: gemini-3.8-flash).
GEMINI_MODEL=
# Local preview without a key: "true" serves a labeled sample brief.
# Ignored in production and whenever GEMINI_API_KEY is set.
BRIEF_DEMO_MODE=

# --- Public business details (shown on the site only when set) -------------
NEXT_PUBLIC_CONTACT_EMAIL=
# Booking link (Calendly, HubSpot Meetings, Cal.com…). Enables "Schedule a conversation".
NEXT_PUBLIC_SCHEDULING_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=

# --- Analytics (nothing loads unless both are set) -------------------------
# "plausible" (recommended, cookieless) or "ga4"
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Plausible: your site domain (e.g. domiutra.com). GA4: measurement ID (G-XXXXXXX).
NEXT_PUBLIC_ANALYTICS_ID=

# --- Careers / ATS (public job-board APIs, no secret needed) ---------------
# "greenhouse" | "lever" | "ashby"
ATS_PROVIDER=
# Greenhouse board token, Lever company slug, or Ashby job-board name.
ATS_BOARD_ID=
